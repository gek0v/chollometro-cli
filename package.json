{
  "name": "chollometro-cli",
  "version": "0.1.0",
  "description": "Herramienta de línea de comandos para explorar, buscar y monitorizar ofertas de Chollometro sin anuncios ni rastreadores.",
  "type": "module",
  "bin": {
    "chollometro": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/unit.test.ts",
    "test:e2e": "tsx --test tests/integration.test.ts",
    "start": "node ./dist/cli.js"
  },
  "keywords": [
    "chollometro",
    "cli",
    "deals",
    "pepper",
    "graphql",
    "shopping",
    "scraper"
  ],
  "author": "Geko",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "got": "^14.4.2",
    "open": "^10.1.0",
    "ora": "^8.1.0",
    "tough-cookie": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/tough-cookie": "^4.0.5",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
